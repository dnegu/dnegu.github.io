---
import SocialIcons from "../../commons/socialIcons/socialIcons.jsx";
import TypeEfect from "../header/typeEfect.jsx";
---

<header class="relative h-screen bg-gray-950 overflow-hidden">
  <div class="absolute inset-0 grid grid-cols-2">
    <div
      class="animate-gradientMove h-80 bg-linear-to-br from-[#982cf0] to-[#581f86] opacity-30 blur-[120px]"
    >
    </div>
    <div
      class="animate-gradientMove2 h-80 bg-linear-to-br from-[#277752] to-[#02ffee] opacity-30 blur-[120px]"
    >
    </div>
  </div>

  <main
    class="relative z-10 flex flex-col items-center justify-center h-full text-center px-4"
  >
    <h1 class="text-4xl md:text-7xl font-bold text-white text-shadow mt-10">
      ¡Hola! Soy David Neyra
    </h1>

    <TypeEfect client:visible />

    <p
      class="text-xs md:text-lg text-gray-200 max-w-sm md:max-w-2xl font-medium mt-3"
    >
      Senior Android Engineer & Mobile Technical Lead con más de 7 años de experiencia diseñando arquitecturas móviles de alto rendimiento, liderando equipos de ingeniería y creando soluciones de misión crítica con Kotlin Multiplatform (KMP).
    </p>
    <SocialIcons client:visible />
    <div class="flex flex-wrap gap-4 justify-center mt-3">
      <a
        href="/about"
        class="px-6 py-3 bg-primary hover:bg-secondary text-white font-semibold rounded-3xl transition-all duration-150
           drop-shadow-[2px_2px_0_#0debd8] active:translate-0.5 active:drop-shadow-none"
      >
        Conoce mi Experiencia
      </a>
      <a
        href="https://www.linkedin.com/in/david-neyra-gutierrez/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 bg-gray-900 hover:bg-gray-800 text-white font-semibold rounded-3xl border border-white/10 transition-all duration-150
           drop-shadow-[2px_2px_0_#7836cf] active:translate-0.5 active:drop-shadow-none"
      >
        Ver Perfil en LinkedIn
      </a>
    </div>
  </main>
</header>

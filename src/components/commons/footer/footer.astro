---
import SocialIcons from "../socialIcons/socialIcons.jsx";
---

<footer class="bg-gray-950 text-white">
  <div
    class="container mx-auto flex flex-col items-center justify-between px-6 py-12 lg:flex-row lg:px-20"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center">
      <h3
        class="text-[#69c7c7] text-4xl font-bold drop-shadow-[1.5px_1.5px_0_#7836cf]"
      >
        DN
      </h3>
    </a>

    <!-- Navigation Links -->
    <nav class="mb-4 lg:mb-0">
      <ul
        class="flex flex-col items-center space-y-2 text-gray-400 lg:flex-row lg:items-start lg:space-y-0 lg:space-x-6"
      >
        <li>
          <a href="/" class="hover:text-[#02ffee] font-semibold transition-colors">Inicio</a>
        </li>
        <li>
          <a href="/proyectos" class="hover:text-[#02ffee] font-semibold transition-colors"
            >Proyectos</a>
        </li>
        <li>
          <a href="/about" class="hover:text-[#02ffee] font-semibold transition-colors"
            >Sobre Mí</a>
        </li>
        <li>
          <a href="/contact" class="hover:text-[#02ffee] font-semibold transition-colors"
            >Contacto</a>
        </li>
      </ul>
    </nav>

    <!-- Social Media Links -->
    <div class="flex space-x-4 ">
      <SocialIcons client:visible />
    </div>
  </div>

  <!-- Copyright -->
  <div
    class="w-full border-t border-gray-800 py-8 text-center text-sm text-gray-400"
  >
    <p>David Neyra &copy; {new Date().getFullYear()} · <a href="mailto:dneyragu@gmail.com" class="hover:text-[#02ffee] underline">dneyragu@gmail.com</a></p>
  </div>
</footer>

<section class="site-container mt-14 mx-auto max-w-6xl px-4">
  <div class="site-container mt-14">
    <h2
      class="text-4xl font-bold flex flex-col items-center gap-6 text-center whitespace-nowrap text-white md:flex-row md:items-center md:text-start"
    >
      <span class="drop-shadow-[2px_2px_0_#7836cf]">Tecnologías & Stack</span>
      <span
        class="hidden h-1.5 grow rounded-lg drop-shadow-[2px_2px_0_#0debd8] bg-[#7836cf] md:block"
      ></span>
    </h2>
  </div>
  <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
    {
      [
        { name: "Kotlin", icon: "kotlin/kotlin-original.svg" },
        { name: "Android SDK", icon: "android/android-original.svg" },
        { name: "Jetpack Compose", icon: "jetpackcompose/jetpackcompose-original.svg" },
        { name: "Java", icon: "java/java-original.svg" },
        { name: "Swift", icon: "swift/swift-original.svg" },
        { name: "C#", icon: "csharp/csharp-original.svg" },
        { name: ".NET Core", icon: "dotnetcore/dotnetcore-original.svg" },
        { name: "SQLite / Room", icon: "sqlite/sqlite-original.svg" },
        { name: "Git", icon: "git/git-original.svg" },
        { name: "Bitbucket", icon: "bitbucket/bitbucket-original.svg" },
        { name: "GitHub Actions", icon: "githubactions/githubactions-original.svg" },
        { name: "Firebase", icon: "firebase/firebase-plain.svg" },
        { name: "MySQL", icon: "mysql/mysql-original.svg" },
        { name: "PostgreSQL", icon: "postgresql/postgresql-original.svg" },
        { name: "Docker", icon: "docker/docker-original.svg" },
        { name: "Gradle", icon: "gradle/gradle-original.svg" },
      ].map((skill) => (
        <div class="relative group">
          <div class="absolute inset-0 -z-10 rounded-lg blur-3xl opacity-0 transition-opacity group-hover:opacity-100" />

          <div class="flex flex-col items-center bg-gray-900 p-4 drop-shadow-[4px_4px_0_#7836cf] rounded-lg shadow-md transition-transform hover:scale-105">
            <img
              src={`https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${skill.icon}`}
              alt={skill.name}
              class="w-12 h-12 object-contain"
              loading="lazy"
            />
            <p class="mt-2 text-white text-base font-semibold drop-shadow-[1px_1px_0_#7836cf] text-center">{skill.name}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

---
import ServiceCard from "./ServiceCard.astro";
import { FaMobileAlt, FaShieldAlt, FaUsersCog } from "react-icons/fa"; 
---

<section class="site-container mt-14 mx-auto max-w-6xl px-4">
	<h2
		class="text-4xl font-bold flex flex-col items-center gap-6 text-center whitespace-nowrap text-white md:flex-row md:items-center md:text-end"
	>
		<span class="hidden h-1.5 grow rounded-lg drop-shadow-[2px_2px_0_#0debd8] bg-[#7836cf] md:block"></span>
		<span class="drop-shadow-[2px_2px_0_#7836cf]">Especialidades & Servicios</span>
	</h2>

	<div class="mt-10 grid gap-6 md:grid-cols-3">
		<ServiceCard
			icon={FaMobileAlt}
			title="Arquitectura Móvil & KMP"
			description="Diseño y migración a Kotlin Multiplatform y Compose Multiplatform con más del 75% de código compartido, Clean Architecture, MVVM y Jetpack Compose."
		/>
		<ServiceCard
			icon={FaShieldAlt}
			title="Seguridad Bancaria & Offline-First"
			description="Motores de sincronización diferencial de alta resiliencia (Room/SQLite), SSL Pinning, rotación JWT y cifrado AES-256 para entornos financieros e industriales."
		/>

		<ServiceCard
			icon={FaUsersCog}
			title="Liderazgo Técnico & CI/CD con IA"
			description="Dirección y mentoría de equipos de hasta 15 ingenieros, pipelines automatizados en Bitbucket/GitHub y validación de PRs asistida por Inteligencia Artificial."
		/>
	</div>
</section>

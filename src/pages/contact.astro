---
import Layout from "../layouts/Layout.astro";
import MiFoto from "../assets/img/MiFoto.png";
import CopyMail from "../components/links/copyMail.jsx";

const links = [
  {
    href: "https://www.linkedin.com/in/david-neyra-gutierrez/",
    label: "LinkedIn · david-neyra-gutierrez",
  },
  { href: "https://github.com/dnegu", label: "GitHub · dnegu" },
  { href: "mailto:dneyragu@gmail.com", label: "Email · dneyragu@gmail.com" },
  { href: "https://wa.me/51987891041", label: "WhatsApp · +51 987 891 041" },
];
---

<Layout title="Contacto | David Neyra" description="Ponte en contacto con David Neyra, Senior Android Engineer y Mobile Tech Lead.">
  <section
    class="bg-gray-900 flex min-h-screen flex-col items-center justify-center px-6 py-20"
  >
    <div class="mb-2 mt-11">
      <div class="relative flex items-center justify-center">
        <!-- Foto con borde -->
        <img
          src={MiFoto.src}
          alt="Foto de David Neyra"
          class="border-primary h-32 w-32 rounded-full shadow-lg object-cover"
        />

        <!-- Texto circular alrededor de la foto -->
        <svg
          viewBox="0 0 200 200"
          class="animate-spin-slow absolute h-48 w-48 pointer-events-none"
        >
          <path
            id="circlePathText"
            d="M100,100 m-77,0 a77,77 0 1,1 154,0 a77,77 0 1,1 -154,0"
            fill="none"></path>
          <text fill="#69c7c7" font-size="14" font-weight="bold">
            <textPath href="#circlePathText" startOffset="0%">
              ✦ DAVID NEYRA ✦ MOBILE TECHNICAL LEAD ✦ SENIOR ANDROID ✦
            </textPath>
          </text>
        </svg>
      </div>
    </div>

    <div class="text-center mt-4">
      <h1 class="text-3xl font-bold text-white">¿Hablamos de un proyecto o rol técnico?</h1>
      <p class="text-gray-300 mt-2 max-w-lg">Disponible para roles de liderazgo móvil, consultoría de arquitectura en Kotlin Multiplatform y nuevos desafíos de ingeniería.</p>
    </div>

    <CopyMail client:visible />

    <!-- Lista de Links -->
    <div class="w-full max-w-xl space-y-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="block font-bold w-full rounded-lg bg-primary hover:bg-secondary drop-shadow-[2px_2px_0_#0debd8] px-6 py-3.5 text-center text-white transition hover:scale-[1.02]"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .animate-spin-slow {
    animation: spin 25s linear infinite;
  }

  @keyframes spin {
    100% {
      transform: rotate(360deg);
    }
  }
</style>
